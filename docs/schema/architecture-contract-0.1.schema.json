{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "architecture-contract-0.1.schema.json",
  "title": "BrotaParser Architecture Contract",
  "description": "Normalized architecture contract emitted by brotaparser@0.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "name",
    "profile",
    "root",
    "dimensions",
    "symbols",
    "dependency_rules",
    "exceptions",
    "path_rules",
    "required_artifacts",
    "rules"
  ],
  "properties": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["language", "schema"],
      "properties": {
        "language": {"const": "0.1"},
        "schema": {"const": "architecture-contract@0.1"}
      }
    },
    "name": {"type": "string", "minLength": 1},
    "profile": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1}
      }
    },
    "derived_from": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "schema"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1}
      }
    },
    "forbidden_paths": {
      "type": "array",
      "items": {"type": "string", "minLength": 1}
    },
    "root": {"type": "string", "minLength": 1},
    "dimensions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "decomposition",
        "internal_structure",
        "dependency_policy",
        "visibility"
      ],
      "properties": {
        "decomposition": {"type": "string"},
        "internal_structure": {"type": "string"},
        "dependency_policy": {"type": "string"},
        "visibility": {"type": "string"}
      }
    },
    "symbols": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind"],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "kind": {"type": "string"}
        }
      }
    },
    "dependency_rules": {
      "type": "array",
      "items": {"$ref": "#/$defs/dependencyRule"}
    },
    "exceptions": {
      "type": "array",
      "items": {
        "allOf": [
          {"$ref": "#/$defs/dependencyRule"},
          {
            "type": "object",
            "required": ["through", "reason"],
            "properties": {
              "through": {"type": "string", "minLength": 1},
              "reason": {"type": "string", "minLength": 1}
            }
          }
        ]
      }
    },
    "path_rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern", "owner"],
        "properties": {
          "pattern": {"type": "string", "minLength": 1},
          "owner": {"type": "string", "minLength": 1}
        }
      }
    },
    "required_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "path", "scope"],
        "properties": {
          "kind": {
            "enum": [
              "file",
              "directory",
              "public-api",
              "export",
              "declaration",
              "configuration"
            ]
          },
          "path": {"type": "string"},
          "scope": {"type": ["string", "null"]}
        }
      }
    },
    "rules": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "origin", "sources", "verification"],
        "properties": {
          "id": {"type": "string"},
          "origin": {
            "enum": [
              "canonical-source",
              "frontend-adaptation",
              "framework-convention",
              "product-decision"
            ]
          },
          "sources": {
            "type": "array",
            "items": {"type": "string"}
          },
          "verification": {
            "enum": ["deterministic", "heuristic", "human-review"]
          }
        }
      }
    }
  },
  "$defs": {
    "dependencyRule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "source", "target"],
      "properties": {
        "kind": {"enum": ["allow", "forbid", "require"]},
        "source": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1}
      }
    }
  }
}
