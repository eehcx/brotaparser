{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "project-snapshot-0.1.schema.json",
  "title": "BrotaParser Project Snapshot",
  "description": "Normalized project facts collected by a downstream adapter for conformance evaluation.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "root",
    "blueprint",
    "directories",
    "files",
    "artifacts",
    "imports",
    "symbols",
    "routes",
    "providers",
    "configurations"
  ],
  "properties": {
    "version": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema"],
      "properties": {"schema": {"const": "project-snapshot@0.1"}}
    },
    "root": {"type": "string", "minLength": 1},
    "blueprint": {"anyOf": [{"$ref": "#/$defs/blueprintReference"}, {"type": "null"}]},
    "directories": {"type": "array", "items": {"$ref": "#/$defs/pathFact"}},
    "files": {"type": "array", "items": {"$ref": "#/$defs/pathFact"}},
    "artifacts": {"type": "array", "items": {"$ref": "#/$defs/artifact"}},
    "imports": {"type": "array", "items": {"$ref": "#/$defs/import"}},
    "symbols": {"type": "array", "items": {"$ref": "#/$defs/symbol"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "providers": {"type": "array", "items": {"$ref": "#/$defs/provider"}},
    "configurations": {"type": "array", "items": {"$ref": "#/$defs/configuration"}}
  },
  "$defs": {
    "blueprintReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "schema"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string", "minLength": 1},
        "schema": {"type": "string", "minLength": 1}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "source", "confidence"],
      "properties": {
        "level": {"enum": ["observed", "inferred", "unresolved"]},
        "source": {"type": "string", "minLength": 1},
        "confidence": {"anyOf": [{"type": "integer", "minimum": 0, "maximum": 100}, {"type": "null"}]}
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "line", "column"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "line": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]},
        "column": {"anyOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]}
      }
    },
    "pathFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "evidence"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "location": {"anyOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kind", "path", "evidence", "location"],
      "properties": {
        "kind": {"enum": ["file", "directory", "public-api", "export", "declaration", "configuration"]},
        "path": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "location": {"anyOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]}
      }
    },
    "import": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_path", "target_path", "source_area", "target_area", "through", "evidence", "location"],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "target_path": {"type": "string", "minLength": 1},
        "source_area": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "target_area": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "through": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "location": {"anyOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]}
      }
    },
    "symbol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "path", "evidence", "location"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "path": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "location": {"anyOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "target", "evidence", "location"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "target": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "location": {"anyOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "token", "evidence", "location"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "token": {"type": "string", "minLength": 1},
        "evidence": {"$ref": "#/$defs/evidence"},
        "location": {"anyOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]}
      }
    },
    "configuration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "key", "value", "evidence", "location"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "key": {"type": "string", "minLength": 1},
        "value": {"anyOf": [{"type": "string"}, {"type": "null"}]},
        "evidence": {"$ref": "#/$defs/evidence"},
        "location": {"anyOf": [{"$ref": "#/$defs/location"}, {"type": "null"}]}
      }
    }
  }
}
